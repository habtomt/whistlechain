# Copy this file to .env and fill in real values. Never commit your real .env file.

# --- UZH Ethereum Proof-of-Stake (PoS) test network ---
# Network Name:    UZH_ETH_PoS
# Chain ID:        70207
# Currency Symbol: UZHETHs
# Block Explorer:  https://explorer.uzheths.ifi.uzh.ch
# These defaults are already baked into hardhat.config.js; only override
# UZH_RPC_URL / UZH_CHAIN_ID here if issues different values later
UZH_RPC_URL=https://rpc.uzheths.ifi.uzh.ch
UZH_CHAIN_ID=70207

# Private key of the deployer account on the UZH Ethereum PoS test network.
# Must hold enough UZHETHs (native gas token) to pay for deployment.
# NEVER commit this value.
DEPLOYER_PRIVATE_KEY=REPLACE_WITH_YOUR_TEST_ACCOUNT_PRIVATE_KEY
